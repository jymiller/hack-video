# Copy to .env and fill in. .env is gitignored; this file is not — keep it valueless.
# On Render these are set in the dashboard, not from a file (see DEPLOY.md).

# Set to 1 to park a deployed demo: every route that spends vendor credit answers
# 503 with an explanation, and the graph pages carry on. There is no auth on this
# app, so an unfrozen public deployment is one anonymous click from a bill. The
# real control is revoking the keys below — this just makes it read as deliberate.
FROZEN=

# TwelveLabs — video indexing, search, analyze, knowledge stores, and the HLS
# manifest URLs the deployed player streams from. Read with .get(), so a blank
# value fails the calls that need it rather than refusing to boot the app.
TWELVELABS_API_KEY=

# OpenAI — model behind the strands agent on /api/agent.
OPENAI_API_KEY=

# You.com — /api/you/search and /api/you/research. Optional; those two endpoints
# report unconfigured without it, the rest of the app runs.
YDC_API_KEY=

# Neo4j. Unset defaults to the local 'hackgraph' container, which is correct for
# dev and wrong everywhere else. Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Path to another project's .env that server.py also loads, purely so the You.com
# key is not duplicated across repos. Leave unset — a missing path is a no-op.
YOU_ENV=
